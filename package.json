{
  "name": "oxygen-bootcamp",
  "private": true,
  "version": "2026.09.1",
  "description": "Oxygen Bootcamp — 90-day authoring training for Oxygen XML and AEM Authoring / AEM Guides.",
  "sideEffects": false,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8080",
    "build": "npm run content:audit && next build",
    "start": "next start --hostname 0.0.0.0 --port 8080",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:audit": "node scripts/content-audit.mjs",
    "content:generate": "node scripts/generate-lessons.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register-ts-ext.mjs --test packages/progress/src/*.test.ts packages/game/src/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "next start --hostname 127.0.0.1 --port 8081",
    "preview:restart": "node scripts/preview-next.mjs",
    "preview:stop": "node scripts/preview-next.mjs stop"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.510.0",
    "next": "^15.5.4",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1"
  }
}
